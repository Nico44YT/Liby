{
  "schemaVersion": 1,
  "id": "liby",
  "version": "${version}",
  "name": "Liby",
  "description": "Registration and MultiBlock Library",
  "authors": [
    "Nico_44"
  ],
  "contact": {
    "homepage": "https://nico44yt.github.io/",
    "issues": "https://github.com/Nico44YT/Liby/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/liby/icon.png",
  "environment": "*",
  "accessWidener": "liby.accesswidener",
  "entrypoints": {
    "client": [
      "nazario.liby.LibyClientEntry"
    ],
    "main": [
      "nazario.liby.LibyMainEntry"
    ]
  },
  "mixins": [
    "liby.mixins.json",
    {
      "config": "liby.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },


  "custom": {
    "modmenu": {
      "links": {
        "modmenu.source": "https://github.com/Nico44YT/Liby"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/class_1792": ["nazario/liby/api/item/LibyItemExtendedMethods"],
      "net/minecraft/class_2248": ["nazario/liby/api/block/LibyBlockExtendedMethods"]
    }
  }
}
